---
import { Font } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/config/site';
import { t } from '@/i18n';
import '@/styles/global.css';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a 1200×630 share image. Defaults to /og-default.png. */
  image?: string;
  noindex?: boolean;
}

const { title, description = site.defaultDescription, image, noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${t.footer.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), site.url).href;
// The default share image is rendered from design/og/ (see README).
const ogImage = new URL(image ?? '/og-default.png', site.url).href;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  logo: new URL('/logo-512.png', site.url).href,
  ...(site.email && { email: site.email }),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e151d" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.lang.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    {!image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t.meta.ogImageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-instrument-sans" preload={[{ subset: 'latin' }]} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#content"
      class="sr-only z-50 rounded-md bg-ink px-4 py-2 text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.skipToContent}
    </a>
    <Header />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </body>
</html>
