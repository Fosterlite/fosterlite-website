---
import Button from '@/components/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';

const copy = t.contact.thanks;
---

<BaseLayout title={copy.title} noindex>
  <section class="mx-auto max-w-content px-4 py-28 sm:px-6 sm:py-36 lg:px-8">
    <h1 class="max-w-2xl text-headline font-semibold text-balance">{copy.heading}</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-muted">{copy.body}</p>
    <div class="mt-10">
      <Button href="/" size="lg">
        {copy.back}
      </Button>
    </div>
  </section>
</BaseLayout>
