---
import Button from '@/components/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { t } from '@/i18n';

const copy = t.contact.fallback;
---

<BaseLayout title={copy.title} noindex>
  <section class="mx-auto max-w-content px-4 py-28 sm:px-6 sm:py-36 lg:px-8">
    <h1 class="max-w-2xl text-headline font-semibold text-balance">{copy.heading}</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-muted">{copy.body}</p>
    <p class="mt-8">
      <a
        href={`mailto:${site.email}`}
        class="text-2xl font-semibold text-accent underline underline-offset-4"
      >
        {site.email}
      </a>
    </p>
    <div class="mt-10">
      <Button href="/contact" variant="secondary" size="lg">
        {copy.back}
      </Button>
    </div>
  </section>
</BaseLayout>
