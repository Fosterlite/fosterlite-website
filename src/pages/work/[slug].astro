---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import CTA from '@/components/CTA.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';

export const getStaticPaths = (async () => {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((study, index) => ({
    params: { slug: study.id },
    props: { study, next: work[(index + 1) % work.length] },
  }));
}) satisfies GetStaticPaths;

const { study, next } = Astro.props;
const { title, client, industry, summary, year, tech, cover, coverAlt, outcomes, placeholder } =
  study.data;
const services = await getEntries(study.data.services);
const { Content } = await render(study);

const facts = [
  { label: t.work.client, value: client },
  { label: t.work.industry, value: industry },
  { label: t.work.services, value: services.map((s) => s.data.title).join(', ') },
  ...(year ? [{ label: t.work.year, value: String(year) }] : []),
  ...(tech.length ? [{ label: t.work.tech, value: tech.join(', ') }] : []),
];
---

<BaseLayout title={title} description={summary} image={cover?.src}>
  <article>
    <header class="mx-auto max-w-content px-4 pt-16 pb-12 sm:px-6 sm:pt-24 lg:px-8">
      <p class="mb-4 text-sm font-semibold tracking-widest text-brand uppercase">
        <a href="/work" class="hover:underline hover:underline-offset-4">
          {t.nav.work}
        </a>
        {placeholder && <span class="ml-2 text-ink-muted normal-case">· {t.work.placeholder}</span>}
      </p>
      <h1 class="max-w-4xl text-headline font-semibold text-balance sm:text-display">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-muted sm:text-xl">{summary}</p>
      <dl class="mt-12 grid gap-6 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((fact) => (
          <div>
            <dt class="text-sm text-ink-muted">{fact.label}</dt>
            <dd class="mt-1 font-medium">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {cover && (
      <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 1024, 1536]}
          sizes="(min-width: 1152px) 1152px, 100vw"
          class="w-full rounded-2xl border border-line"
          loading="eager"
        />
      </div>
    )}

    {outcomes.length > 0 && (
      <div class="mx-auto max-w-content px-4 pt-16 sm:px-6 lg:px-8">
        <dl class="grid gap-6 sm:grid-cols-3">
          {outcomes.map((outcome) => (
            <div class="rounded-2xl bg-surface p-6">
              <dt class="text-sm text-ink-muted">{outcome.label}</dt>
              <dd class="mt-2 text-3xl font-semibold text-brand">{outcome.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div class="mx-auto max-w-content px-4 pt-4 pb-16 sm:px-6 lg:px-8">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {next && next.id !== study.id && (
    <nav aria-label={t.work.next} class="border-t border-line">
      <a
        href={`/work/${next.id}`}
        class="group mx-auto block max-w-content px-4 py-12 sm:px-6 lg:px-8"
      >
        <span class="text-sm font-medium text-ink-muted">{t.work.next}</span>
        <span class="mt-2 block text-2xl font-semibold group-hover:underline group-hover:underline-offset-4">
          {next.data.title} →
        </span>
      </a>
    </nav>
  )}

  <CTA />
</BaseLayout>
