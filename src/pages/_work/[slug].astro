---
// Parked with the rest of src/pages/_work/ (see index.astro).
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import CTA from '@/components/CTA.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';

export const getStaticPaths = (async () => {
  const products = (await getCollection('work', (entry) => !entry.data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return products.map((product, index) => ({
    params: { slug: product.id },
    props: { product, next: products[(index + 1) % products.length] },
  }));
}) satisfies GetStaticPaths;

const { product, next } = Astro.props;
const { name, title, category, status, summary, intro, tech, externalUrl, cover, coverAlt } =
  product.data;
const { Content } = await render(product);

const facts = [
  { label: t.work.category, value: category },
  { label: t.work.status, value: t.work.statuses[status] },
  ...(tech.length ? [{ label: t.work.builtWith, value: tech.join(', ') }] : []),
];
---

<BaseLayout title={name} description={summary} image={cover?.src}>
  <article>
    <header class="mx-auto max-w-content px-4 pt-16 pb-12 sm:px-6 sm:pt-24 lg:px-8">
      <p class="mb-4 text-sm font-semibold tracking-widest text-brand uppercase">
        <a href="/work" class="hover:underline hover:underline-offset-4">
          {t.nav.work}
        </a>
        <span class="text-ink-muted"> · {name}</span>
      </p>
      <h1 class="max-w-4xl text-headline font-semibold text-balance sm:text-display">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-muted sm:text-xl">{intro ?? summary}</p>
      {externalUrl && (
        <div class="mt-8">
          <Button href={externalUrl} variant="secondary">
            {t.work.visit}
          </Button>
        </div>
      )}
      <dl class="mt-12 grid gap-6 border-t border-line pt-8 sm:grid-cols-3">
        {facts.map((fact) => (
          <div>
            <dt class="text-sm text-ink-muted">{fact.label}</dt>
            <dd class="mt-1 font-medium">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {cover && (
      <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 1024, 1536]}
          sizes="(min-width: 1152px) 1152px, 100vw"
          class="w-full rounded-2xl border border-line"
          loading="eager"
        />
      </div>
    )}

    <div class="mx-auto max-w-content px-4 pt-4 pb-16 sm:px-6 lg:px-8">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {next && next.id !== product.id && (
    <nav aria-label={t.work.next} class="border-t border-line">
      <a
        href={`/work/${next.id}`}
        class="group mx-auto block max-w-content px-4 py-12 sm:px-6 lg:px-8"
      >
        <span class="text-sm font-medium text-ink-muted">{t.work.next}</span>
        <span class="mt-2 block text-2xl font-semibold group-hover:underline group-hover:underline-offset-4">
          {next.data.name} →
        </span>
      </a>
    </nav>
  )}

  <CTA />
</BaseLayout>
