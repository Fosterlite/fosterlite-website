---
import type { CollectionEntry } from 'astro:content';
import { t } from '@/i18n';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const href = `/services#${service.id}`;
---

<article class="group relative flex flex-col rounded-2xl border border-line bg-bg p-7">
  <h3 class="text-xl font-semibold text-balance">
    <a href={href} class="after:absolute after:inset-0 after:rounded-2xl">
      {service.data.title}
    </a>
  </h3>
  <p class="mt-3 flex-1 text-ink-muted">{service.data.summary}</p>
  <p
    aria-hidden="true"
    class="mt-6 text-sm font-semibold text-accent group-hover:underline group-hover:underline-offset-4"
  >
    {t.services.learnMore} →
  </p>
</article>
