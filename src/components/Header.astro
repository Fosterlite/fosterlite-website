---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { contactHref, nav } from '@/config/site';
import { t } from '@/i18n';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-content items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="-m-1 p-1" aria-label={t.nav.home}>
      <Logo class="h-8 w-auto" />
    </a>

    <nav aria-label={t.nav.label} class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-8 text-sm font-medium">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="text-ink-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={contactHref} aria-current={isCurrent(contactHref) ? 'page' : undefined}>
        {t.nav.contact}
      </Button>
    </nav>

    <!-- Mobile menu: native popover gives toggle, Escape and light-dismiss with zero JS. -->
    <button
      type="button"
      popovertarget="mobile-nav"
      class="-mr-2 rounded-md px-3 py-2 text-sm font-semibold md:hidden"
    >
      {t.nav.menu}
    </button>
    <nav
      id="mobile-nav"
      popover
      aria-label={t.nav.label}
      class="m-0 h-dvh max-h-none w-full max-w-none bg-bg p-0 text-ink md:hidden"
    >
      <div class="flex h-16 items-center justify-between border-b border-line px-4 sm:px-6">
        <a href="/" class="-m-1 p-1" aria-label={t.nav.home}>
          <Logo class="h-8 w-auto" />
        </a>
        <button
          type="button"
          popovertarget="mobile-nav"
          popovertargetaction="hide"
          class="-mr-2 rounded-md px-3 py-2 text-sm font-semibold"
        >
          {t.nav.close}
        </button>
      </div>
      <ul class="flex flex-col gap-1 px-4 py-6 text-2xl font-semibold sm:px-6">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="block py-3 aria-[current=page]:text-brand"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="px-4 sm:px-6">
        <Button href={contactHref} size="lg" class="w-full">
          {t.nav.contact}
        </Button>
      </div>
    </nav>
  </div>
</header>
