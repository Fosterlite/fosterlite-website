---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { t } from '@/i18n';

interface Props {
  study: CollectionEntry<'work'>;
  headingLevel?: 'h2' | 'h3';
}

const { study, headingLevel: Heading = 'h3' } = Astro.props;
const { title, client, industry, summary, cover, coverAlt, placeholder } = study.data;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-bg">
  <div class="aspect-[16/10] bg-surface">
    {cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="flex h-full items-end p-6">
        <span class="text-sm font-medium text-ink-muted">{industry}</span>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-7">
    <p class="text-sm font-medium text-brand">
      {client}
      {placeholder && (
        <span class="ml-2 rounded-full border border-line px-2 py-0.5 text-xs text-ink-muted">
          {t.work.placeholder}
        </span>
      )}
    </p>
    <Heading class="mt-2 text-xl font-semibold text-balance">
      <a href={`/work/${study.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
        {title}
      </a>
    </Heading>
    <p class="mt-3 flex-1 text-ink-muted">{summary}</p>
    <p
      aria-hidden="true"
      class="mt-6 text-sm font-semibold text-accent group-hover:underline group-hover:underline-offset-4"
    >
      {t.work.readCase} →
    </p>
  </div>
</article>
