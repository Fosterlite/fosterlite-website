---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { t } from '@/i18n';

interface Props {
  product: CollectionEntry<'work'>;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel: Heading = 'h3' } = Astro.props;
const { name, title, category, status, summary, cover, coverAlt } = product.data;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-bg">
  {cover && (
    <Image
      src={cover}
      alt={coverAlt ?? ''}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[16/10] w-full object-cover"
    />
  )}
  <div class="flex flex-1 flex-col p-7">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <span class="font-semibold text-brand">{name}</span>
      <span class="text-ink-muted">{category}</span>
      <span class="rounded-full border border-line px-2 py-0.5 text-xs text-ink-muted">
        {t.work.statuses[status]}
      </span>
    </p>
    <Heading class="mt-3 text-xl font-semibold text-balance">
      <a href={`/work/${product.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
        {title}
      </a>
    </Heading>
    <p class="mt-3 flex-1 text-ink-muted">{summary}</p>
    <p
      aria-hidden="true"
      class="mt-6 text-sm font-semibold text-accent group-hover:underline group-hover:underline-offset-4"
    >
      {t.work.learnMore} →
    </p>
  </div>
</article>
