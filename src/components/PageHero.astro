---
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { eyebrow, heading, lede } = Astro.props;
---

<section class="mx-auto max-w-content px-4 pt-16 pb-12 sm:px-6 sm:pt-24 sm:pb-16 lg:px-8">
  {eyebrow && (
    <p class="mb-4 text-sm font-semibold tracking-widest text-brand uppercase">{eyebrow}</p>
  )}
  <h1 class="max-w-4xl text-headline font-semibold text-balance sm:text-display">{heading}</h1>
  {lede && <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-muted sm:text-xl">{lede}</p>}
  <slot />
</section>
